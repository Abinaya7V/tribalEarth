# TribalEarth AI — environment configuration
# Copy this file to .env and fill in real values. .env is gitignored
# and must never be committed. Without these, /api/voice/transcribe
# and /api/voice/tts will honestly respond "Voice service is not
# configured" rather than faking a result — the app still works for
# every other feature, and browser-based voice input/TTS fallback
# (Web Speech API) still functions in the frontend where available.

# Digital India Bhashini (NLTM) API credentials.
# Obtain these from https://bhashini.gov.in/ after registering as a
# developer/service consumer.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_SERVICE_ID=
BHASHINI_BASE_URL=https://meity-auth.ulcacontrib.org

# Optional: server port (defaults to 4000 if unset)
PORT=4000

# Environment mode (development / production)
NODE_ENV=development

# Optional: storage directory for SQLite database, document uploads, access logs, and OCR cache.
# Defaults to server/data if unset. On Render or Docker, point this to a persistent disk (e.g. /var/data).
# DATA_DIR=/var/data

# Optional: custom absolute or relative path to the SQLite database file.
# Defaults to $DATA_DIR/tribalearth.db if unset.
# DB_PATH=

# Optional: set to "true" to automatically seed 13 demo claims and proof documents into DATA_DIR
# if and only if the SQLite database has zero claims at startup. Ignored if claims already exist.
# SEED_DEMO=true
